generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ==========================================
// Identity & Better Auth Domain
// ==========================================

model User {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Better Auth Relations
  sessions Session[]
  accounts Account[]

  // Extended FoodOS fields
  phone           String?
  fullName        String?
  displayName     String?
  avatarUrl       String?
  status          String    @default("ACTIVE") // INVITED, ACTIVE, SUSPENDED, DEACTIVATED
  lastLoginAt     DateTime?
  preferredLocale String?   @default("en")
  metadata        Json?

  memberships Membership[]
  employees   Employee[]

  @@map("user")
}

model Session {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String   @db.Uuid
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("session")
}

model Account {
  id                    String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accountId             String
  providerId            String
  userId                String    @db.Uuid
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("account")
}

model Verification {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime? @default(now())
  updatedAt  DateTime? @updatedAt

  @@map("verification")
}

model Membership {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String    @db.Uuid
  userId          String    @db.Uuid
  restaurantId    String?   @db.Uuid
  branchId        String?   @db.Uuid
  scope           String // ORGANIZATION, RESTAURANT, BRANCH
  status          String    @default("ACTIVE") // INVITED, ACTIVE, SUSPENDED, REMOVED
  invitedByUserId String?   @db.Uuid
  invitedAt       DateTime?
  acceptedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id])
  branch       Branch?      @relation(fields: [branchId], references: [id])

  roles MembershipRole[]

  @@unique([userId, organizationId, scope, restaurantId, branchId], name: "unique_membership_scope")
  @@map("membership")
}

model Role {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  description    String?
  isSystemRole   Boolean @default(false)
  isDefault      Boolean @default(false)
  status         String  @default("ACTIVE") // ACTIVE, ARCHIVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  permissions  RolePermission[]
  memberships  MembershipRole[]

  @@unique([organizationId, name])
  @@map("role")
}

model Permission {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key                String  @unique
  domain             String
  resource           String
  action             String
  description        String?
  isSystemPermission Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles RolePermission[]

  @@map("permission")
}

model RolePermission {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId       String @db.Uuid
  permissionId String @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permission")
}

model MembershipRole {
  id           String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  membershipId String @db.Uuid
  roleId       String @db.Uuid

  membership Membership @relation(fields: [membershipId], references: [id], onDelete: Cascade)
  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([membershipId, roleId])
  @@map("membership_role")
}

// ==========================================
// Restaurant Domain
// ==========================================

model Organization {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  legalName       String
  tradeName       String?
  slug            String  @unique
  countryCode     String
  defaultCurrency String  @default("INR")
  defaultTimezone String  @default("Asia/Kolkata")
  status          String  @default("ACTIVE") // TRIAL, ACTIVE, PAST_DUE, SUSPENDED, CLOSED
  planCode        String?
  billingEmail    String?
  metadata        Json?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  restaurants          Restaurant[]
  branches             Branch[]
  memberships          Membership[]
  roles                Role[]
  departments          Department[]
  diningTables         DiningTable[]
  branchSettings       BranchSettings[]
  employees            Employee[]
  auditLogs            AuditLog[]
  outboxEvents         DomainEventOutbox[]
  orders               Order[]
  kitchenTickets       KitchenTicket[]
  notificationMessages NotificationMessage[]
  payments             Payment[]
  invoices             Invoice[]
  integrationConfigs   IntegrationProviderConfig[]
  webhookEvents        WebhookEvent[]
  externalReferences   ExternalReference[]

  drivers                Driver[]
  deliveryPartnerConfigs DeliveryPartnerConfig[]
  deliveryAssignments    DeliveryAssignment[]
  deliveryEvents         DeliveryEvent[]

  menus              Menu[]
  menuCategories     MenuCategory[]
  menuItems          MenuItem[]
  menuItemPlacements MenuItemPlacement[]
  modifierGroups     ModifierGroup[]
  modifierOptions    ModifierOption[]
  priceRules         PriceRule[]
  itemAvailabilities ItemAvailability[]
  taxCategories      TaxCategory[]
  ingredients        Ingredient[]
  stockLots          StockLot[]
  stockMovements     StockMovement[]
  suppliers          Supplier[]
  purchaseOrders     PurchaseOrder[]
  purchaseOrderLines PurchaseOrderLine[]
  wasteEntries       WasteEntry[]
  recipeLines        RecipeLine[]
  inventoryAlerts    InventoryAlert[]
  customers          Customer[]
  kpiSnapshots       KpiSnapshot[]
  dailySummaries     DailyBusinessSummary[]
  aiInsights         AIInsight[]

  @@map("organization")
}

model Restaurant {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId      String   @db.Uuid
  name                String
  slug                String
  brandLogoUrl        String?
  cuisineTypes        String[]
  description         String?
  status              String   @default("DRAFT") // DRAFT, ACTIVE, PAUSED, ARCHIVED
  primaryContactName  String?
  primaryContactPhone String?
  primaryContactEmail String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branches     Branch[]
  memberships  Membership[]
  employees    Employee[]
  orders       Order[]

  menus          Menu[]
  menuItems      MenuItem[]
  modifierGroups ModifierGroup[]
  priceRules     PriceRule[]
  kpiSnapshots   KpiSnapshot[]
  dailySummaries DailyBusinessSummary[]
  aiInsights     AIInsight[]

  @@unique([organizationId, slug])
  @@map("restaurant")
}

model Branch {
  id                       String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId           String  @db.Uuid
  restaurantId             String  @db.Uuid
  name                     String
  branchCode               String
  branchType               String // DINE_IN, CLOUD_KITCHEN, TAKEAWAY, CATERING, HYBRID
  status                   String  @default("SETUP") // SETUP, ACTIVE, TEMPORARILY_CLOSED, PERMANENTLY_CLOSED
  phone                    String?
  email                    String?
  addressLine1             String?
  addressLine2             String?
  city                     String?
  state                    String?
  postalCode               String?
  countryCode              String?
  latitude                 Float?
  longitude                Float?
  timezone                 String  @default("Asia/Kolkata")
  serviceDayCutoverMinutes Int     @default(0) // minutes past midnight (e.g. 120 = 2 AM)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
  version   Int       @default(1)

  organization       Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant         Restaurant                  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  memberships        Membership[]
  departments        Department[]
  diningTables       DiningTable[]
  settings           BranchSettings?
  employees          Employee[]
  orders             Order[]
  kitchenTickets     KitchenTicket[]
  payments           Payment[]
  invoices           Invoice[]
  integrationConfigs IntegrationProviderConfig[]

  drivers                Driver[]
  deliveryPartnerConfigs DeliveryPartnerConfig[]
  deliveryAssignments    DeliveryAssignment[]

  menus              Menu[]
  menuItems          MenuItem[]
  priceRules         PriceRule[]
  itemAvailabilities ItemAvailability[]
  stockLots          StockLot[]
  stockMovements     StockMovement[]
  purchaseOrderLines PurchaseOrderLine[]
  wasteEntries       WasteEntry[]
  inventoryAlerts    InventoryAlert[]
  kpiSnapshots       KpiSnapshot[]
  dailySummaries     DailyBusinessSummary[]
  purchaseOrders     PurchaseOrder[]
  aiInsights         AIInsight[]

  @@unique([restaurantId, branchCode])
  @@map("branch")
}

model Department {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String @db.Uuid
  branchId       String @db.Uuid
  name           String
  departmentType String // KITCHEN, SERVICE, CASHIER, DELIVERY, MANAGEMENT, OTHER
  status         String @default("ACTIVE") // ACTIVE, INACTIVE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, name])
  @@map("department")
}

model DiningTable {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  branchId       String  @db.Uuid
  label          String
  section        String?
  capacity       Int
  qrCode         String? @unique
  status         String  @default("AVAILABLE") // AVAILABLE, OCCUPIED, RESERVED, BLOCKED, INACTIVE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  orders       Order[]

  @@unique([branchId, label])
  @@map("dining_table")
}

model BranchSettings {
  id                        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId            String  @db.Uuid
  branchId                  String  @unique @db.Uuid
  acceptsDineIn             Boolean @default(false)
  acceptsTakeaway           Boolean @default(false)
  acceptsDelivery           Boolean @default(false)
  autoAcceptOrders          Boolean @default(false)
  printKitchenTickets       Boolean @default(false)
  taxInclusivePricing       Boolean @default(false)
  defaultPreparationMinutes Int     @default(15)
  lowStockThresholdMode     String  @default("GLOBAL") // GLOBAL, PER_ITEM
  settingsJson              Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branch       Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("branch_settings")
}

// ==========================================
// Staff Domain
// ==========================================

model Employee {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  restaurantId   String?   @db.Uuid
  branchId       String?   @db.Uuid
  userId         String?   @db.Uuid
  employeeCode   String
  fullName       String
  phone          String?
  email          String?
  jobTitle       String
  employmentType String    @default("FULL_TIME") // FULL_TIME, PART_TIME, CONTRACT, TEMPORARY
  status         String    @default("ACTIVE") // ACTIVE, ON_LEAVE, SUSPENDED, EXITED
  joinedAt       DateTime?
  exitedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  drivers      Driver[]

  @@unique([organizationId, employeeCode])
  @@map("employee")
}

// ==========================================
// Platform Sync & Audit Domain
// ==========================================

model DomainEventOutbox {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  eventName      String
  aggregateType  String
  aggregateId    String    @db.Uuid
  payloadJson    Json
  metadataJson   Json?
  status         String    @default("PENDING") // PENDING, PUBLISHED, FAILED, DEAD_LETTER
  occurredAt     DateTime  @default(now())
  publishedAt    DateTime?
  attemptCount   Int       @default(0)
  lastError      String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("domain_event_outbox")
}

model AuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  actorUserId    String?  @db.Uuid
  actorType      String // USER, SYSTEM, PROVIDER, AI
  action         String
  entityType     String
  entityId       String   @db.Uuid
  beforeJson     Json?
  afterJson      Json?
  ipAddress      String?
  userAgent      String?
  occurredAt     DateTime @default(now())

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("audit_log")
}

// ==========================================
// Menu Domain
// ==========================================

model Menu {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  restaurantId   String    @db.Uuid
  branchId       String?   @db.Uuid
  name           String
  menuType       String // DINE_IN, TAKEAWAY, DELIVERY, CATERING, ALL_DAY, CUSTOM
  status         String    @default("DRAFT") // DRAFT, ACTIVE, SCHEDULED, ARCHIVED
  startsAt       DateTime?
  endsAt         DateTime?
  sortOrder      Int       @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch?             @relation(fields: [branchId], references: [id])
  categories   MenuCategory[]
  placements   MenuItemPlacement[]

  @@map("menu")
}

model MenuCategory {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  menuId         String  @db.Uuid
  name           String
  description    String?
  imageUrl       String?
  sortOrder      Int     @default(0)
  status         String  @default("ACTIVE") // ACTIVE, HIDDEN, ARCHIVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menu         Menu                @relation(fields: [menuId], references: [id], onDelete: Cascade)
  placements   MenuItemPlacement[]

  @@unique([menuId, name])
  @@map("menu_category")
}

model MenuItem {
  id                 String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String  @db.Uuid
  restaurantId       String  @db.Uuid
  branchId           String? @db.Uuid
  sku                String?
  name               String
  description        String?
  itemType           String // FOOD, BEVERAGE, PACKAGING, SERVICE, COMBO
  dietaryType        String? // VEG, NON_VEG, EGG, VEGAN, JAIN, OTHER
  basePriceMinor     Int
  currency           String  @default("INR")
  taxCategoryId      String? @db.Uuid
  imageUrl           String?
  preparationMinutes Int?
  isRecommended      Boolean @default(false)
  isStockTracked     Boolean @default(false)
  status             String  @default("DRAFT") // DRAFT, ACTIVE, UNAVAILABLE, ARCHIVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant     Restaurant          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch         Branch?             @relation(fields: [branchId], references: [id])
  taxCategory    TaxCategory?        @relation(fields: [taxCategoryId], references: [id])
  placements     MenuItemPlacement[]
  modifierGroups ModifierGroup[]
  priceRules     PriceRule[]
  availability   ItemAvailability[]
  orderItems     OrderItem[]
  recipeLines    RecipeLine[]

  @@map("menu_item")
}

model MenuItemPlacement {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String   @db.Uuid
  menuId          String   @db.Uuid
  categoryId      String   @db.Uuid
  menuItemId      String   @db.Uuid
  sortOrder       Int      @default(0)
  visibleChannels String[]
  status          String   @default("ACTIVE") // ACTIVE, HIDDEN

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menu         Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@unique([categoryId, menuItemId])
  @@map("menu_item_placement")
}

model ModifierGroup {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  restaurantId   String  @db.Uuid
  menuItemId     String? @db.Uuid
  name           String
  selectionType  String // SINGLE, MULTIPLE
  minSelections  Int     @default(0)
  maxSelections  Int     @default(1)
  isRequired     Boolean @default(false)
  sortOrder      Int     @default(0)
  status         String  @default("ACTIVE") // ACTIVE, ARCHIVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant       @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem     MenuItem?        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  options      ModifierOption[]

  @@map("modifier_group")
}

model ModifierOption {
  id              String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId  String  @db.Uuid
  modifierGroupId String  @db.Uuid
  name            String
  priceDeltaMinor Int     @default(0)
  currency        String  @default("INR")
  isDefault       Boolean @default(false)
  sortOrder       Int     @default(0)
  status          String  @default("ACTIVE") // ACTIVE, UNAVAILABLE, ARCHIVED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  modifierGroup ModifierGroup @relation(fields: [modifierGroupId], references: [id], onDelete: Cascade)

  @@unique([modifierGroupId, name])
  @@map("modifier_option")
}

model PriceRule {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String    @db.Uuid
  restaurantId   String    @db.Uuid
  branchId       String?   @db.Uuid
  menuItemId     String    @db.Uuid
  channel        String    @default("ALL") // DINE_IN, TAKEAWAY, DELIVERY, MARKETPLACE, ALL
  priceMinor     Int
  currency       String    @default("INR")
  startsAt       DateTime?
  endsAt         DateTime?
  priority       Int       @default(0)
  status         String    @default("ACTIVE") // ACTIVE, INACTIVE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("price_rule")
}

model ItemAvailability {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  menuItemId     String  @db.Uuid
  branchId       String? @db.Uuid
  channel        String  @default("ALL")
  dayOfWeek      Int? // 0-6
  startTimeLocal String? // "09:00"
  endTimeLocal   String? // "22:00"
  manualOverride String  @default("NONE") // AVAILABLE, UNAVAILABLE, NONE
  reason         String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItem     MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@map("item_availability")
}

// ==========================================
// Finance Domain
// ==========================================

model TaxCategory {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String  @db.Uuid
  name           String
  countryCode    String
  taxType        String // GST, VAT, SALES_TAX, SERVICE_TAX, OTHER
  ratePercent    Float
  isInclusive    Boolean @default(false)
  status         String  @default("ACTIVE") // ACTIVE, INACTIVE

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  version   Int      @default(1)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItems    MenuItem[]

  @@map("tax_category")
}

// ==========================================
// Orders, Kitchen, and POS Domain
// ==========================================

model Order {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId     String    @db.Uuid
  restaurantId       String    @db.Uuid
  branchId           String    @db.Uuid
  orderNumber        String
  channel            String // DINE_IN, TAKEAWAY, DELIVERY, POS, MARKETPLACE
  source             String // STAFF_POS, QR, PHONE, WEB, WHATSAPP, MARKETPLACE, API
  customerId         String?   @db.Uuid
  tableId            String?   @db.Uuid
  status             String    @default("DRAFT") // DRAFT, PLACED, ACCEPTED, IN_KITCHEN, READY, SERVED, OUT_FOR_DELIVERY, COMPLETED, CANCELLED, REFUNDED
  paymentStatus      String    @default("UNPAID") // UNPAID, PARTIALLY_PAID, PAID, REFUNDED, FAILED
  fulfillmentStatus  String    @default("NOT_STARTED") // NOT_STARTED, PREPARING, READY, FULFILLED, FAILED
  subtotalMinor      Int       @default(0)
  discountMinor      Int       @default(0)
  taxMinor           Int       @default(0)
  serviceChargeMinor Int       @default(0)
  deliveryFeeMinor   Int       @default(0)
  totalMinor         Int       @default(0)
  currency           String    @default("INR")
  notes              String?
  placedAt           DateTime?
  acceptedAt         DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelReason       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization        Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
