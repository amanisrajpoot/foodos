  deliveryAssignmentId String   @db.Uuid
  eventType            String
  eventSource          String   @default("LOCAL") // LOCAL, PROVIDER_WEBHOOK, STAFF
  message              String?
  latitude             Float?
  longitude            Float?
  occurredAt           DateTime @default(now())
  rawPayload           Json?

  createdAt DateTime @default(now())

  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveryAssignment DeliveryAssignment @relation(fields: [deliveryAssignmentId], references: [id], onDelete: Cascade)

  @@map("delivery_event")
}

// ==========================================
// Analytics Domain
// ==========================================

model KpiSnapshot {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId String   @db.Uuid
  restaurantId   String?  @db.Uuid
  branchId       String?  @db.Uuid
  metricKey      String
  domain         String
  periodType     String // HOURLY, DAILY, WEEKLY, MONTHLY
  periodStart    DateTime
  periodEnd      DateTime
  valueNumeric   Float?
  valueJson      Json?
  computedAt     DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([organizationId, metricKey, periodType])
  @@index([branchId, metricKey, periodType, periodStart])
  @@map("kpi_snapshot")
}

model DailyBusinessSummary {
  id                     String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId         String   @db.Uuid
  restaurantId           String?  @db.Uuid
  branchId               String?  @db.Uuid
  businessDate           DateTime @db.Date
  summaryText            String
  salesTotalMinor        Int
  orderCount             Int
  topItemsJson           Json?
  lowStockItemsJson      Json?
  customerHighlightsJson Json?
  riskFlagsJson          Json?
  generatedBy            String // SYSTEM, AI
  generatedAt            DateTime @default(now())

  // AI Enrichments
  aiNarrativeText        String?
  anomaliesJson          Json?
  aiModelProvider        String?
  aiModelName            String?
  aiGeneratedAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, businessDate])
  @@index([organizationId, businessDate])
  @@map("daily_business_summary")
}

// ==========================================
// AI Domain
// ==========================================

model AIInsight {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organizationId    String    @db.Uuid
  restaurantId      String?   @db.Uuid
  branchId          String?   @db.Uuid
  insightType       String    // SALES, INVENTORY, KITCHEN, CUSTOMER, MARKETING, FINANCE, SUPPORT
  severity          String    // INFO, LOW, MEDIUM, HIGH, CRITICAL
  title             String
  body              String
  recommendation    String?
  sourceEntityType  String?
  sourceEntityId    String?
  sourcePeriodStart DateTime?
  sourcePeriodEnd   DateTime?
  modelProvider     String    @default("SYSTEM")
  modelName         String?
  confidenceScore   Float?
  status            String    @default("NEW") // NEW, ACKNOWLEDGED, ACTIONED, DISMISSED, EXPIRED

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  restaurant   Restaurant?  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  branch       Branch?      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([branchId, insightType, status])
  @@map("ai_insight")
}



